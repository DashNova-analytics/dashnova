{
  "name": "dashnova",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npx prisma generate --schema=backend/prisma/schema.prisma && tsx server.js",
    "build": "npx prisma generate --schema=backend/prisma/schema.prisma && cd frontend && npx vite build && cd .. && npx esbuild server.js --bundle --platform=node --format=esm --packages=external --outfile=dist/server.cjs",
    "start": "node server.js",
    "lint": "echo 'No lint required'"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.9",
    "@google/genai": "^2.4.0",
    "@prisma/client": "^5.12.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^1.4.5-lts.1",
    "papaparse": "^5.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.82.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.0",
    "swagger-ui-express": "^4.6.3",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "nodemon": "^3.0.1",
    "prisma": "^5.12.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
